# Copy to .env and adjust. Both values are optional.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.

# Canonical URL for metadata, sitemap, robots, JSON-LD and Open Graph.
# Default: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, else http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to turn off Vercel Web Analytics and Speed Insights.
# They only load when Vercel sets VERCEL=1, so self-hosted copies load nothing anyway.
NEXT_PUBLIC_DISABLE_ANALYTICS=
